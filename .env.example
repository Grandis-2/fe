# 카카오 개발자 콘솔 > 내 애플리케이션 > 앱 키에서 발급받는다.
# 실제 값은 .env.local에 넣는다(*.local은 .gitignore로 커밋되지 않는다).
# Admin 키는 여기 넣지 않는다 — VITE_ 접두사는 클라이언트 번들에 그대로 노출된다.
VITE_KAKAO_OAUTH_REST_API_KEY=

# 토스페이먼츠 개발자센터 > 내 개발정보 > API 키에서 발급받는 "API 개별 연동" 테스트
# 클라이언트 키(test_ck_...). 위젯/브랜드페이용 키와는 다른 키이니 결제창(개별연동)용을
# 받아야 한다. 시크릿 키는 여기 넣지 않는다 — 결제 승인은 백엔드가 시크릿 키로 한다.
VITE_TOSS_PAYMENTS_CLIENT_KEY=

# MSW(목 API) 사용 여부. 비워 두면 dev는 on, 배포(prod)는 off.
# dev에서 실제 API에 붙어볼 땐 false, 배포에서 목으로 띄울 땐 true.
VITE_USE_MSW=

# 목 결제 승인이 AUTHORIZING에 머무는 시간(ms). 비우면 바로 끝난다.
# 승인 중 폴링·타임아웃 뒤 재전송·새로고침을 재현할 때 15000처럼 넣는다.
VITE_MOCK_CONFIRM_DELAY_MS=

# true면 목에서 결제한 사전예약을 취소할 때 환불이 실패한다(주문 내역의 환불 실패 안내를 볼 때).
VITE_MOCK_REFUND_FAIL=

# 실사용자 모니터링(Grafana Faro) 수집 주소. Vercel Production 환경 변수에만 넣는다
# (https://rum.grandis-nova.link/collect). 비워 두면 꺼진다 — 로컬·Preview·목 배포는 비운다.
VITE_FARO_URL=

# 사용 행태 분석(Amplitude) API 키. Amplitude > Settings > Projects > API Keys에서 받는다.
# 비워 두면 꺼진다. 로컬에서 확인할 땐 .env.local에 넣는다(운영 프로젝트와 섞이지 않게 dev 프로젝트 키 권장).
VITE_AMPLITUDE_API_KEY=
