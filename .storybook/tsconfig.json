{
  // 루트 tsconfig의 include 글롭은 점으로 시작하는 디렉터리(.storybook)를 건너뛰어서
  // 이 폴더의 파일들이 어떤 프로젝트에도 안 잡힌다. 그러면 에디터가 vite/client 타입을
  // 못 찾아 `import '...css'` 같은 부수 효과 import에 TS2882가 뜬다.
  // 여기에 tsconfig를 두면 글롭 기준이 .storybook/ 안쪽이 되어 정상적으로 잡힌다.
  "extends": "../tsconfig.app.json",
  "compilerOptions": {
    "tsBuildInfoFile": "../node_modules/.tmp/tsconfig.storybook.tsbuildinfo"
  },
  "include": ["**/*.ts", "**/*.tsx"]
}
